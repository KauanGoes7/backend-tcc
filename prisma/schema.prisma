// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Provedor correto para SQLite
  url      = env("DATABASE_URL")
}

// Modelo de Usuário
model User {
  id        Int      @id @default(autoincrement()) // ID para SQLite: Int e autoincrement
  nome      String
  email     String   @unique
  senha     String
  appointments Appointment[] // Relação com agendamentos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo de Serviço
model Service {
  id          Int      @id @default(autoincrement()) // ID para SQLite: Int e autoincrement
  tema        String   // Ex: "Cabelo", "Barba", "Cabelo + Barba"
  nomeServico String
  appointments Appointment[] // Relação com agendamentos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelo de Barbeiro
model Barber {
  id           Int      @id @default(autoincrement()) // ID para SQLite: Int e autoincrement
  nomeBarbeiro String
  appointments Appointment[] // Relação com agendamentos
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Modelo de Agendamento
model Appointment {
  id          Int      @id @default(autoincrement()) // ID para SQLite: Int e autoincrement
  dia         Int
  mes         Int

  // Relações com outros modelos - Chaves estrangeiras agora são Int
  usuarioId   Int // Chave estrangeira para User
  usuario     User     @relation(fields: [usuarioId], references: [id])

  servicoId   Int // Chave estrangeira para Service
  servico     Service  @relation(fields: [servicoId], references: [id])

  barbeiroId  Int // Chave estrangeira para Barber
  barbeiro    Barber   @relation(fields: [barbeiroId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}